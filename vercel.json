{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --omit=optional --no-audit --no-fund",
  "buildCommand": "node tools/vercel-build.js",
  "outputDirectory": "public",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/server.js": {
      "maxDuration": 300,
      "includeFiles": "{public/defs.js,store.js}",
      "excludeFiles": "{public/assets/**,public/admin/**,data/**,tools/**,*.png,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/health",
      "destination": "/api/server?r=health"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|html|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
